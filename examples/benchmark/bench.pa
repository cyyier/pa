N = 50000000
MOD = 2147483648


# 31-bit LCG: x * 1103515245 overflows 32 bits, so it relies on the default 64-bit int
def lcg_sum(n) -> int:
    x = 12345
    s = 0
    for i in range(n):
        x = (x * 1103515245 + 12345) % MOD
        s += x % 1000
    return s


# Leibniz series for pi: alternating 1/(2i+1) terms, multiplied by 4 at the end
def leibniz(n) -> float:
    s = 0.0
    sign = 1.0
    for i in range(n):
        s = s + sign / (2 * i + 1)
        sign = -sign
    return 4.0 * s


def main() -> int:
    print(lcg_sum(N))
    print(leibniz(N))
    return 0
