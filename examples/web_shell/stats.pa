# All business logic lives here (compiled to native code). The FastAPI shell only does I/O.


@export
def mean(xs: span[f64]) -> f64:
    s = 0.0
    for i in range(len(xs)):
        s = s + xs[i]
    return s / len(xs)


@export
def variance(xs: span[f64]) -> f64:
    m = mean(xs)
    acc = 0.0
    for i in range(len(xs)):
        d = xs[i] - m
        acc = acc + d * d
    return acc / len(xs)


@export
def moving_average(xs: span[f64], window: i64, out: ptr[f64]) -> i64:
    n = len(xs) - window + 1
    for i in range(n):
        s = 0.0
        for j in range(window):
            s = s + xs[i + j]
        out[i] = s / window
    return n


@export
def trace(m: span[f64], n: i64) -> f64:
    t = 0.0
    for i in range(n):
        t = t + m[i * n + i]
    return t
