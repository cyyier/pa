import io_bridge

MAX_N = 100000

PI = 3.141592653589793
TWO_PI = 2.0 * PI
DEG_TO_RAD = PI / 180.0
RAD_TO_DEG = 180.0 / PI

K0 = 0.9996
R = 6378137.0

E = 0.00669438
E2 = E * E
E3 = E2 * E
E_P2 = E / (1.0 - E)

SQRT_E = 0.9966471893303066
U_E = (1.0 - SQRT_E) / (1.0 + SQRT_E)
U_E2 = U_E * U_E
U_E3 = U_E2 * U_E
U_E4 = U_E3 * U_E
U_E5 = U_E4 * U_E

M1 = 1.0 - E / 4.0 - 3.0 * E2 / 64.0 - 5.0 * E3 / 256.0
M2 = 3.0 * E / 8.0 + 3.0 * E2 / 32.0 + 45.0 * E3 / 1024.0
M3 = 15.0 * E2 / 256.0 + 45.0 * E3 / 1024.0
M4 = 35.0 * E3 / 3072.0

P2 = 1.5 * U_E - 27.0 / 32.0 * U_E3 + 269.0 / 512.0 * U_E5
P3 = 21.0 / 16.0 * U_E2 - 55.0 / 32.0 * U_E4
P4 = 151.0 / 96.0 * U_E3 - 417.0 / 128.0 * U_E5
P5 = 1097.0 / 512.0 * U_E4

ZONE_LETTERS = "CDEFGHJKLMNPQRSTUVWXX"


@struct
class UtmPoint:
    easting: float
    northing: float
    zone_number: int
    zone_letter: u8
    northern: bool


@struct
class LatLon:
    lat: float
    lon: float


# Wraps a radian angle into [-pi, pi) using floored remainder (Pa % is C fmod)
def mod_angle(value) -> float:
    r = (value + PI) % TWO_PI
    if r < 0.0:
        r = r + TWO_PI
    return r - PI


# Normalizes longitude in degrees into [-180, 180) using floored remainder
def normalize_lon(lon) -> float:
    r = (lon + 180.0) % 360.0
    if r < 0.0:
        r = r + 360.0
    return r - 180.0


# Handles Svalbard special UTM zones (72 <= lat <= 84, lon >= 0)
def svalbard_zone(lon) -> int:
    if lon < 9.0:
        return 31
    if lon < 21.0:
        return 33
    if lon < 33.0:
        return 35
    if lon < 42.0:
        return 37
    return int((lon + 180.0) / 6.0) + 1


# Computes UTM zone number (1..60) including Norway and Svalbard exceptions
def latlon_to_zone_number(lat, lon) -> int:
    nlon = normalize_lon(lon)
    if 56.0 <= lat and lat < 64.0 and 3.0 <= nlon and nlon < 12.0:
        return 32
    if 72.0 <= lat and lat <= 84.0 and nlon >= 0.0:
        return svalbard_zone(nlon)
    return int((nlon + 180.0) / 6.0) + 1


# Maps latitude in [-80, 84] to UTM zone letter ASCII byte (u8 to pack UtmPoint)
def latitude_to_zone_letter(lat) -> u8:
    idx = int(lat + 80.0) >> 3
    return ZONE_LETTERS[idx]


def zone_central_lon(zone_number) -> float:
    return float((zone_number - 1) * 6 - 180 + 3)


# Transverse Mercator projection (WGS84): converts one (lat, lon) to UtmPoint
def from_latlon_one(lat, lon) -> UtmPoint:
    lat_rad = lat * DEG_TO_RAD
    lat_sin = sin(lat_rad)
    lat_cos = cos(lat_rad)
    lat_tan = lat_sin / lat_cos
    lat_tan2 = lat_tan * lat_tan
    lat_tan4 = lat_tan2 * lat_tan2
    zone_num = latlon_to_zone_number(lat, lon)
    zone_let = latitude_to_zone_letter(lat)
    northern = zone_let >= 78
    lon_rad = lon * DEG_TO_RAD
    c_lon_rad = zone_central_lon(zone_num) * DEG_TO_RAD
    n = R / sqrt(1.0 - E * lat_sin * lat_sin)
    c = E_P2 * lat_cos * lat_cos
    a = lat_cos * mod_angle(lon_rad - c_lon_rad)
    a2 = a * a
    a3 = a2 * a
    a4 = a3 * a
    a5 = a4 * a
    a6 = a5 * a
    m = R * (M1 * lat_rad - M2 * sin(2.0 * lat_rad) + M3 * sin(4.0 * lat_rad) - M4 * sin(6.0 * lat_rad))
    e_term = a + a3 / 6.0 * (1.0 - lat_tan2 + c) + a5 / 120.0 * (5.0 - 18.0 * lat_tan2 + lat_tan4 + 72.0 * c - 58.0 * E_P2)
    easting = K0 * n * e_term + 500000.0
    n_term = a2 / 2.0 + a4 / 24.0 * (5.0 - lat_tan2 + 9.0 * c + 4.0 * c * c) + a6 / 720.0 * (61.0 - 58.0 * lat_tan2 + lat_tan4 + 600.0 * c - 330.0 * E_P2)
    northing = K0 * (m + n * lat_tan * n_term)
    if not northern:
        northing = northing + 10000000.0
    return UtmPoint(easting=easting, northing=northing, zone_number=zone_num, zone_letter=zone_let, northern=northern)


# Inverse Transverse Mercator (WGS84): converts one UTM point back to (lat, lon)
def to_latlon_one(easting, northing, zone_num, northern) -> LatLon:
    x = easting - 500000.0
    y = northing if northern else northing - 10000000.0
    m = y / K0
    mu = m / (R * M1)
    p_rad = mu + P2 * sin(2.0 * mu) + P3 * sin(4.0 * mu) + P4 * sin(6.0 * mu) + P5 * sin(8.0 * mu)
    p_sin = sin(p_rad)
    p_sin2 = p_sin * p_sin
    p_cos = cos(p_rad)
    p_tan = p_sin / p_cos
    p_tan2 = p_tan * p_tan
    p_tan4 = p_tan2 * p_tan2
    ep_sin = 1.0 - E * p_sin2
    n = R / sqrt(ep_sin)
    r = (1.0 - E) / ep_sin
    c = E_P2 * p_cos * p_cos
    c2 = c * c
    d = x / (n * K0)
    d2 = d * d
    d3 = d2 * d
    d4 = d3 * d
    d5 = d4 * d
    d6 = d5 * d
    lat_t = d2 / 2.0 - d4 / 24.0 * (5.0 + 3.0 * p_tan2 + 10.0 * c - 4.0 * c2 - 9.0 * E_P2) + d6 / 720.0 * (61.0 + 90.0 * p_tan2 + 298.0 * c + 45.0 * p_tan4 - 252.0 * E_P2 - 3.0 * c2)
    lat = p_rad - (p_tan / r) * lat_t
    lon_t = d - d3 / 6.0 * (1.0 + 2.0 * p_tan2 + c) + d5 / 120.0 * (5.0 - 2.0 * c + 28.0 * p_tan2 - 3.0 * c2 + 8.0 * E_P2 + 24.0 * p_tan4)
    lon = mod_angle(lon_t / p_cos + zone_central_lon(zone_num) * DEG_TO_RAD)
    return LatLon(lat=lat * RAD_TO_DEG, lon=lon * RAD_TO_DEG)


# Flat SoA batch forward kernel: zero allocations inside the loop
def batch_from_latlon(lats, lons, eastings, northings, zones, letters) -> void:
    n = len(lats)
    for i in range(n):
        pt = from_latlon_one(lats[i], lons[i])
        eastings[i] = pt.easting
        northings[i] = pt.northing
        zones[i] = pt.zone_number
        letters[i] = pt.zone_letter


# Flat SoA batch inverse kernel: zero allocations inside the loop
def batch_to_latlon(eastings, northings, zones, letters, out_lats, out_lons) -> void:
    n = len(eastings)
    for i in range(n):
        northern = letters[i] >= 78
        ll = to_latlon_one(easting=eastings[i], northing=northings[i], zone_num=zones[i], northern=northern)
        out_lats[i] = ll.lat
        out_lons[i] = ll.lon


# Loads 100k coords via .paw, runs flat forward+inverse kernels, saves results via .paw
def main() -> int:
    lats = io_bridge.load_lats()
    lons = io_bridge.load_lons()
    n = len(lats)
    if n > MAX_N:
        return 2
    eastings = [0.0] * MAX_N
    northings = [0.0] * MAX_N
    zones = [0] * MAX_N
    letters = [ZONE_LETTERS[0]] * MAX_N
    rt_lats = [0.0] * MAX_N
    rt_lons = [0.0] * MAX_N
    t0 = io_bridge.now_sec()
    batch_from_latlon(lats=lats, lons=lons, eastings=mut(eastings), northings=mut(northings), zones=mut(zones), letters=mut(letters))
    t1 = io_bridge.now_sec()
    batch_to_latlon(eastings=eastings, northings=northings, zones=zones, letters=letters, out_lats=mut(rt_lats), out_lons=mut(rt_lons))
    t2 = io_bridge.now_sec()
    io_bridge.save_utm(span(eastings, 0, n), span(northings, 0, n), span(zones, 0, n), span(letters, 0, n))
    io_bridge.save_roundtrip(span(rt_lats, 0, n), span(rt_lons, 0, n))
    print(t1 - t0, t2 - t1)
    return 0
