# Crossing zone: file I/O and wall-clock timing for the UTM benchmark.
import os
import time
import numpy as np


def _data_dir() -> str:
    return os.environ.get("PA_UTM_DATA_DIR", os.path.dirname(os.path.abspath(__file__)))


def load_lats() -> Vec[float]:
    return np.load(os.path.join(_data_dir(), "in_lats.npy")).astype(np.float64, copy=False)


def load_lons() -> Vec[float]:
    return np.load(os.path.join(_data_dir(), "in_lons.npy")).astype(np.float64, copy=False)


def now_sec() -> float:
    return float(time.perf_counter())


def save_utm(eastings: span[float], northings: span[float], zones: span[int], letters: span[u8]) -> void:
    d = _data_dir()
    np.save(os.path.join(d, "pa_eastings.npy"), np.frombuffer(eastings, dtype=np.float64))
    np.save(os.path.join(d, "pa_northings.npy"), np.frombuffer(northings, dtype=np.float64))
    np.save(os.path.join(d, "pa_zones.npy"), np.frombuffer(zones, dtype=np.int64))
    np.save(os.path.join(d, "pa_letters.npy"), np.frombuffer(letters, dtype=np.uint8))


def save_roundtrip(lats: span[float], lons: span[float]) -> void:
    d = _data_dir()
    np.save(os.path.join(d, "pa_rt_lats.npy"), np.frombuffer(lats, dtype=np.float64))
    np.save(os.path.join(d, "pa_rt_lons.npy"), np.frombuffer(lons, dtype=np.float64))
