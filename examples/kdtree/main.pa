import io_bridge

IMG_W = 512
IMG_H = 512


@struct
class Vec2:
    x: float
    y: float


@struct
class KdNode:
    pt: Vec2
    orig_idx: int
    left: int
    right: int
    axis: u8


@struct
class QueryHit:
    idx: int
    dist2: float


def coord_of(pt, axis) -> float:
    if axis == 0:
        return pt.x
    return pt.y


def dist2_pt(a, b) -> float:
    dx = a.x - b.x
    dy = a.y - b.y
    return dx * dx + dy * dy


def swap_node(nodes, i, j) -> void:
    tmp = nodes[i]
    nodes[i] = nodes[j]
    nodes[j] = tmp


# Lomuto partition of nodes[lo..hi] around pivot_idx along axis (0=x, 1=y)
def partition_axis(nodes, lo, hi, pivot_idx, axis) -> int:
    pval = coord_of(nodes[pivot_idx].pt, axis)
    swap_node(nodes=mut(nodes), i=pivot_idx, j=hi)
    store = lo
    for i in range(lo, hi):
        if coord_of(nodes[i].pt, axis) < pval:
            swap_node(nodes=mut(nodes), i=store, j=i)
            store = store + 1
    swap_node(nodes=mut(nodes), i=store, j=hi)
    return store


# Quickselect: places the k-th smallest node along axis into nodes[k] in O(n) average
def quickselect(nodes, lo, hi, k, axis) -> void:
    while lo < hi:
        mid = (lo + hi) >> 1
        p = partition_axis(
            nodes=mut(nodes), lo=lo, hi=hi, pivot_idx=mid, axis=axis,
        )
        if p == k:
            return
        if k < p:
            hi = p - 1
        else:
            lo = p + 1


# Recursively builds an in-place balanced 2D KD-Tree over nodes[lo..hi]
def build_kd(nodes, lo, hi, depth) -> int:
    if lo > hi:
        return -1
    axis = depth % 2
    mid = (lo + hi) >> 1
    quickselect(nodes=mut(nodes), lo=lo, hi=hi, k=mid, axis=axis)
    lc = build_kd(nodes=mut(nodes), lo=lo, hi=mid - 1, depth=depth + 1)
    rc = build_kd(nodes=mut(nodes), lo=mid + 1, hi=hi, depth=depth + 1)
    cur = nodes[mid]
    nodes[mid] = KdNode(
        pt=cur.pt, orig_idx=cur.orig_idx, left=lc, right=rc, axis=axis,
    )
    return mid


# Manual-stack nearest-neighbor search with branch-and-bound pruning on nested KdNode
def nn_query(nodes, root, qx, qy) -> QueryHit:
    q = Vec2(x=qx, y=qy)
    best_idx = -1
    best_d2 = 1e308
    stack = [0] * 128
    sp = 0
    stack[0] = root
    sp = 1
    while sp > 0:
        sp = sp - 1
        ni = stack[sp]
        nd = nodes[ni]
        d2 = dist2_pt(nd.pt, q)
        if d2 < best_d2:
            best_d2 = d2
            best_idx = nd.orig_idx
        diff = coord_of(q, nd.axis) - coord_of(nd.pt, nd.axis)
        near = nd.left if diff < 0.0 else nd.right
        far = nd.right if diff < 0.0 else nd.left
        if far != -1 and diff * diff < best_d2:
            stack[sp] = far
            sp = sp + 1
        if near != -1:
            stack[sp] = near
            sp = sp + 1
    return QueryHit(idx=best_idx, dist2=best_d2)


# Runs batch nearest-neighbor queries into pre-allocated flat output arrays
def batch_query(nodes, root, qx, qy, out_idx, out_d2) -> void:
    nq = len(qx)
    for i in range(nq):
        hit = nn_query(nodes=nodes, root=root, qx=qx[i], qy=qy[i])
        out_idx[i] = hit.idx
        out_d2[i] = hit.dist2


# Deterministic cell color channel (u8) from site index and distance contour shading
def shade_channel(site_idx, mult, d, boost) -> u8:
    base = (site_idx * mult + boost) % 180 + 55
    ring = 0.72 + 0.28 * cos(d * 0.55)
    val = int(float(base) * ring)
    if val < 0:
        val = 0
    if val > 255:
        val = 255
    return val


# Renders a 512x512 Voronoi + distance-contour RGB buffer via 262k KD-Tree queries
def render_voronoi(nodes, root, rgb) -> void:
    scale_x = 1000.0 / float(IMG_W)
    scale_y = 1000.0 / float(IMG_H)
    for py in range(IMG_H):
        wy = (float(py) + 0.5) * scale_y
        row = py * IMG_W
        for px in range(IMG_W):
            wx = (float(px) + 0.5) * scale_x
            hit = nn_query(nodes=nodes, root=root, qx=wx, qy=wy)
            d = sqrt(hit.dist2)
            off = (row + px) * 3
            rgb[off] = shade_channel(site_idx=hit.idx, mult=73, d=d, boost=19)
            rgb[off + 1] = shade_channel(site_idx=hit.idx, mult=151, d=d, boost=67)
            rgb[off + 2] = shade_channel(site_idx=hit.idx, mult=211, d=d, boost=113)


# Builds 2D KD-Tree from points loaded via .paw, runs 50k NN queries + 512x512 PIL render
def main() -> int:
    px = io_bridge.load_px()
    py = io_bridge.load_py()
    qx = io_bridge.load_qx()
    qy = io_bridge.load_qy()
    n = len(px)
    nq = len(qx)
    dummy = KdNode(pt=Vec2(x=0.0, y=0.0), orig_idx=0, left=-1, right=-1, axis=0)
    nodes = [dummy] * n
    for i in range(n):
        nodes[i] = KdNode(
            pt=Vec2(x=px[i], y=py[i]), orig_idx=i, left=-1, right=-1, axis=0,
        )
    out_idx = [0] * nq
    out_d2 = [0.0] * nq
    t0 = io_bridge.now_sec()
    root = build_kd(nodes=mut(nodes), lo=0, hi=n - 1, depth=0)
    t1 = io_bridge.now_sec()
    batch_query(
        nodes=nodes, root=root, qx=qx, qy=qy,
        out_idx=mut(out_idx), out_d2=mut(out_d2),
    )
    t2 = io_bridge.now_sec()
    io_bridge.save_hits(out_idx, out_d2)
    z0 = dummy.axis
    rgb = [z0] * (IMG_W * IMG_H * 3)
    render_voronoi(nodes=nodes, root=root, rgb=mut(rgb))
    io_bridge.save_png(rgb, IMG_W, IMG_H)
    print(t1 - t0, t2 - t1)
    return 0
