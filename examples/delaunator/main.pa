import io_bridge

EPS = 1e-12


@struct
class Point2D:
    x: float
    y: float


@struct
class SeedTri:
    i0: int
    i1: int
    i2: int
    cx: float
    cy: float


def dist2(ax, ay, bx, by) -> float:
    dx = ax - bx
    dy = ay - by
    return dx * dx + dy * dy


# Positive when (a, b, c) is clockwise in y-down / matches Mapbox Delaunator orient2d
def orient2d(px, py, qx, qy, rx, ry) -> float:
    return (py - ry) * (qx - rx) - (px - rx) * (qy - ry)


# Returns squared circumradius of triangle (a, b, c), or 1e308 if collinear
def circumradius2(ax, ay, bx, by, cx, cy) -> float:
    dx = bx - ax
    dy = by - ay
    ex = cx - ax
    ey = cy - ay
    bl = dx * dx + dy * dy
    cl = ex * ex + ey * ey
    d = 0.5 / (dx * ey - dy * ex)
    x = (ey * bl - dy * cl) * d
    y = (dx * cl - ex * bl) * d
    return x * x + y * y


# Computes circumcenter of triangle (a, b, c) as a Point2D struct
def circumcenter(ax, ay, bx, by, cx, cy) -> Point2D:
    dx = bx - ax
    dy = by - ay
    ex = cx - ax
    ey = cy - ay
    bl = dx * dx + dy * dy
    cl = ex * ex + ey * ey
    d = 0.5 / (dx * ey - dy * ex)
    x = ax + (ey * bl - dy * cl) * d
    y = ay + (dx * cl - ex * bl) * d
    return Point2D(x=x, y=y)


# Returns True if point p lies strictly inside the circumcircle of (a, b, c)
def in_circle(ax, ay, bx, by, cx, cy, px, py) -> bool:
    dx = ax - px
    dy = ay - py
    ex = bx - px
    ey = by - py
    fx = cx - px
    fy = cy - py
    ap = dx * dx + dy * dy
    bp = ex * ex + ey * ey
    cp = fx * fx + fy * fy
    det = dx * (ey * cp - bp * fy) - dy * (ex * cp - bp * fx) + ap * (ex * fy - ey * fx)
    return det < 0.0


# Monotonic pseudo-angle in [0, 1) for angular hull hashing (avoids atan2)
def pseudo_angle(dx, dy) -> float:
    p = dx / (abs(dx) + abs(dy))
    if dy > 0.0:
        return (3.0 - p) / 4.0
    return (1.0 + p) / 4.0


# Maps (x, y) around circumcenter (cx, cy) into [0, hash_size)
def hash_key(x, y, cx, cy, hash_size) -> int:
    ang = pseudo_angle(x - cx, y - cy)
    k = int(floor(ang * float(hash_size))) % hash_size
    if k < 0:
        k = k + hash_size
    return k


# Finds the bounding-box center of (xs, ys)
def bbox_center(xs, ys) -> Point2D:
    n = len(xs)
    min_x = xs[0]
    min_y = ys[0]
    max_x = xs[0]
    max_y = ys[0]
    for i in range(1, n):
        x = xs[i]
        y = ys[i]
        if x < min_x:
            min_x = x
        if y < min_y:
            min_y = y
        if x > max_x:
            max_x = x
        if y > max_y:
            max_y = y
    return Point2D(x=(min_x + max_x) * 0.5, y=(min_y + max_y) * 0.5)


# Picks the point closest to (cx, cy) as seed vertex i0
def find_closest_to(xs, ys, cx, cy) -> int:
    n = len(xs)
    best = 0
    min_d = 1e308
    for i in range(n):
        d = dist2(ax=xs[i], ay=ys[i], bx=cx, by=cy)
        if d < min_d:
            best = i
            min_d = d
    return best


# Picks the point closest to i0 (excluding i0) as seed vertex i1
def find_nearest_neighbor(xs, ys, i0) -> int:
    n = len(xs)
    x0 = xs[i0]
    y0 = ys[i0]
    best = 0
    min_d = 1e308
    for i in range(n):
        if i == i0:
            continue
        d = dist2(ax=x0, ay=y0, bx=xs[i], by=ys[i])
        if d < min_d and d > 0.0:
            best = i
            min_d = d
    return best


# Picks i2 minimizing circumradius with (i0, i1) and orients the seed triangle
def build_seed_triangle(xs, ys) -> SeedTri:
    ctr = bbox_center(xs, ys)
    i0 = find_closest_to(xs=xs, ys=ys, cx=ctr.x, cy=ctr.y)
    i1 = find_nearest_neighbor(xs=xs, ys=ys, i0=i0)
    i2 = find_min_circum_vertex(xs=xs, ys=ys, i0=i0, i1=i1)
    if orient2d(px=xs[i0], py=ys[i0], qx=xs[i1], qy=ys[i1], rx=xs[i2], ry=ys[i2]) < 0.0:
        tmp = i1
        i1 = i2
        i2 = tmp
    cc = circumcenter(ax=xs[i0], ay=ys[i0], bx=xs[i1], by=ys[i1], cx=xs[i2], cy=ys[i2])
    return SeedTri(i0=i0, i1=i1, i2=i2, cx=cc.x, cy=cc.y)


# Finds vertex i2 that forms the smallest circumcircle with (i0, i1)
def find_min_circum_vertex(xs, ys, i0, i1) -> int:
    n = len(xs)
    x0 = xs[i0]
    y0 = ys[i0]
    x1 = xs[i1]
    y1 = ys[i1]
    best = 0
    min_r = 1e308
    for i in range(n):
        if i == i0 or i == i1:
            continue
        r = circumradius2(ax=x0, ay=y0, bx=x1, by=y1, cx=xs[i], cy=ys[i])
        if r < min_r:
            best = i
            min_r = r
    return best


def swap_i(arr, i, j) -> void:
    tmp = arr[i]
    arr[i] = arr[j]
    arr[j] = tmp


# Insertion sort for small quicksort partitions (right - left <= 20)
def insertion_sort(ids, dists, left, right) -> void:
    for i in range(left + 1, right + 1):
        id_val = ids[i]
        d_val = dists[id_val]
        j = i - 1
        while j >= left and dists[ids[j]] > d_val:
            ids[j + 1] = ids[j]
            j = j - 1
        ids[j + 1] = id_val


# Median-of-three Hoare partition for quicksort on ids by dists
def partition_ids(ids, dists, left, right) -> int:
    mid = (left + right) >> 1
    swap_i(arr=mut(ids), i=mid, j=left + 1)
    if dists[ids[left]] > dists[ids[right]]:
        swap_i(arr=mut(ids), i=left, j=right)
    if dists[ids[left + 1]] > dists[ids[right]]:
        swap_i(arr=mut(ids), i=left + 1, j=right)
    if dists[ids[left]] > dists[ids[left + 1]]:
        swap_i(arr=mut(ids), i=left, j=left + 1)
    i = left + 1
    j = right
    pivot_id = ids[left + 1]
    pivot = dists[pivot_id]
    while True:
        i = i + 1
        while dists[ids[i]] < pivot:
            i = i + 1
        j = j - 1
        while dists[ids[j]] > pivot:
            j = j - 1
        if j < i:
            break
        swap_i(arr=mut(ids), i=i, j=j)
    ids[left + 1] = ids[j]
    ids[j] = pivot_id
    return j


# Iterative quicksort of point ids by radial distance from seed circumcenter
def quicksort_ids(ids, dists, n) -> void:
    stack_l = [0] * 128
    stack_r = [0] * 128
    top = 0
    stack_l[0] = 0
    stack_r[0] = n - 1
    while top >= 0:
        left = stack_l[top]
        right = stack_r[top]
        top = top - 1
        if right - left <= 20:
            insertion_sort(ids=mut(ids), dists=dists, left=left, right=right)
            continue
        j = partition_ids(ids=mut(ids), dists=dists, left=left, right=right)
        if right - j >= j - left:
            top = top + 1
            stack_l[top] = j + 1
            stack_r[top] = right
            top = top + 1
            stack_l[top] = left
            stack_r[top] = j - 1
        else:
            top = top + 1
            stack_l[top] = left
            stack_r[top] = j - 1
            top = top + 1
            stack_l[top] = j + 1
            stack_r[top] = right


# Links two opposite half-edges a and b (-1 means hull boundary edge)
def link_edge(halfedges, a, b) -> void:
    halfedges[a] = b
    if b != -1:
        halfedges[b] = a


# Appends a triangle (i0, i1, i2) to dynamic Vecs triangles/halfedges and returns base edge index
def add_triangle(triangles, halfedges, i0, i1, i2, a, b, c) -> int:
    t = len(triangles)
    triangles.append(i0)
    triangles.append(i1)
    triangles.append(i2)
    halfedges.append(-1)
    halfedges.append(-1)
    halfedges.append(-1)
    link_edge(halfedges=mut(halfedges), a=t, b=a)
    link_edge(halfedges=mut(halfedges), a=t + 1, b=b)
    link_edge(halfedges=mut(halfedges), a=t + 2, b=c)
    return t


# Performs one Delaunay edge flip on half-edge pair (a, b) and updates hull_tri if needed
def flip_edge(triangles, halfedges, hull_tri, a, b, al, bl) -> int:
    ar = a - a % 3 + (a + 2) % 3
    p0 = triangles[ar]
    p = triangles[bl]
    triangles[a] = p
    triangles[b] = p0
    hbl = halfedges[bl]
    if hbl == -1:
        hull_tri[p] = a
    link_edge(halfedges=mut(halfedges), a=a, b=hbl)
    link_edge(halfedges=mut(halfedges), a=b, b=halfedges[ar])
    link_edge(halfedges=mut(halfedges), a=ar, b=bl)
    return b - b % 3 + (b + 1) % 3


# Restores Delaunay empty-circumcircle property via iterative stack-based edge flipping
def legalize(xs, ys, triangles, halfedges, hull_tri, a) -> int:
    edge_stack = [0] * 512
    sp = 0
    ar = 0
    while True:
        b = halfedges[a]
        a0 = a - a % 3
        ar = a0 + (a + 2) % 3
        if b == -1:
            if sp == 0:
                break
            sp = sp - 1
            a = edge_stack[sp]
            continue
        b0 = b - b % 3
        al = a0 + (a + 1) % 3
        bl = b0 + (b + 2) % 3
        p0 = triangles[ar]
        pr = triangles[a]
        pl = triangles[al]
        p1 = triangles[bl]
        if in_circle(ax=xs[p0], ay=ys[p0], bx=xs[pr], by=ys[pr], cx=xs[pl], cy=ys[pl], px=xs[p1], py=ys[p1]):
            br = flip_edge(triangles=mut(triangles), halfedges=mut(halfedges), hull_tri=mut(hull_tri), a=a, b=b, al=al, bl=bl)
            if sp < 512:
                edge_stack[sp] = br
                sp = sp + 1
            continue
        if sp == 0:
            break
        sp = sp - 1
        a = edge_stack[sp]
    return ar


# Probes the angular hull hash table to find a nearby convex-hull vertex for point (x, y)
def find_hull_edge(hull_hash, hull_next, key, hash_size) -> int:
    start = 0
    for j in range(hash_size):
        start = hull_hash[(key + j) % hash_size]
        if start != -1 and start != hull_next[start]:
            return start
    return start


# Walks backward along the hull to find the first visible edge from (x, y)
def walk_hull_back(xs, ys, hull_prev, hull_next, start, x, y) -> int:
    start0 = hull_prev[start]
    e = start0
    q = hull_next[e]
    while orient2d(px=x, py=y, qx=xs[e], qy=ys[e], rx=xs[q], ry=ys[q]) >= 0.0:
        e = q
        if e == start0:
            return -1
        q = hull_next[e]
    return e


# Walks forward along the hull adding triangles for all remaining visible edges
def walk_hull_forward(xs, ys, triangles, halfedges, hull_next, hull_prev, hull_tri, i, e, x, y) -> int:
    q = hull_next[e]
    n_idx = hull_next[q]
    while orient2d(px=x, py=y, qx=xs[q], qy=ys[q], rx=xs[n_idx], ry=ys[n_idx]) < 0.0:
        t = add_triangle(triangles=mut(triangles), halfedges=mut(halfedges), i0=q, i1=i, i2=n_idx, a=hull_tri[i], b=-1, c=hull_tri[q])
        hull_tri[i] = legalize(xs=xs, ys=ys, triangles=mut(triangles), halfedges=mut(halfedges), hull_tri=mut(hull_tri), a=t + 2)
        hull_next[q] = q
        q = n_idx
        n_idx = hull_next[q]
    return q


# Walks backward from e adding triangles for all visible edges behind e
def walk_hull_backward_add(xs, ys, triangles, halfedges, hull_prev, hull_next, hull_tri, i, e, x, y) -> int:
    q = hull_prev[e]
    while orient2d(px=x, py=y, qx=xs[q], qy=ys[q], rx=xs[e], ry=ys[e]) < 0.0:
        t = add_triangle(triangles=mut(triangles), halfedges=mut(halfedges), i0=q, i1=i, i2=e, a=-1, b=hull_tri[e], c=hull_tri[q])
        legalize(xs=xs, ys=ys, triangles=mut(triangles), halfedges=mut(halfedges), hull_tri=mut(hull_tri), a=t + 2)
        hull_tri[q] = t
        hull_next[e] = e
        e = q
        q = hull_prev[e]
    return e


# Inserts one sorted point i into the advancing hull and triangulates visible edges
def insert_point(xs, ys, triangles, halfedges, hull_prev, hull_next, hull_tri, hull_hash, hash_size, cx, cy, i) -> void:
    x = xs[i]
    y = ys[i]
    key = hash_key(x=x, y=y, cx=cx, cy=cy, hash_size=hash_size)
    start = find_hull_edge(hull_hash=hull_hash, hull_next=hull_next, key=key, hash_size=hash_size)
    e = walk_hull_back(xs=xs, ys=ys, hull_prev=hull_prev, hull_next=hull_next, start=start, x=x, y=y)
    if e == -1:
        return
    t = add_triangle(triangles=mut(triangles), halfedges=mut(halfedges), i0=e, i1=i, i2=hull_next[e], a=-1, b=-1, c=hull_tri[e])
    hull_tri[i] = legalize(xs=xs, ys=ys, triangles=mut(triangles), halfedges=mut(halfedges), hull_tri=mut(hull_tri), a=t + 2)
    hull_tri[e] = t
    q = walk_hull_forward(xs=xs, ys=ys, triangles=mut(triangles), halfedges=mut(halfedges), hull_next=mut(hull_next), hull_prev=hull_prev, hull_tri=mut(hull_tri), i=i, e=e, x=x, y=y)
    if e == hull_prev[start]:
        e = walk_hull_backward_add(xs=xs, ys=ys, triangles=mut(triangles), halfedges=mut(halfedges), hull_prev=hull_prev, hull_next=mut(hull_next), hull_tri=mut(hull_tri), i=i, e=e, x=x, y=y)
    hull_prev[i] = e
    hull_next[e] = i
    hull_prev[q] = i
    hull_next[i] = q
    hull_hash[key] = i
    hull_hash[hash_key(x=xs[e], y=ys[e], cx=cx, cy=cy, hash_size=hash_size)] = e


# Prepares sorted point indices and radial distances from the seed circumcenter
def prepare_sorted_ids(xs, ys, cx, cy, ids, dists) -> void:
    n = len(xs)
    for i in range(n):
        ids[i] = i
        dists[i] = dist2(ax=xs[i], ay=ys[i], bx=cx, by=cy)
    quicksort_ids(ids=mut(ids), dists=dists, n=n)


# Initializes hull circular list, hull hash table, and emits the seed triangle
def init_hull(xs, ys, seed, triangles, halfedges, hull_prev, hull_next, hull_tri, hull_hash, hash_size) -> void:
    i0 = seed.i0
    i1 = seed.i1
    i2 = seed.i2
    hull_next[i0] = i1
    hull_prev[i2] = i1
    hull_next[i1] = i2
    hull_prev[i0] = i2
    hull_next[i2] = i0
    hull_prev[i1] = i0
    hull_tri[i0] = 0
    hull_tri[i1] = 1
    hull_tri[i2] = 2
    hull_hash[hash_key(x=xs[i0], y=ys[i0], cx=seed.cx, cy=seed.cy, hash_size=hash_size)] = i0
    hull_hash[hash_key(x=xs[i1], y=ys[i1], cx=seed.cx, cy=seed.cy, hash_size=hash_size)] = i1
    hull_hash[hash_key(x=xs[i2], y=ys[i2], cx=seed.cx, cy=seed.cy, hash_size=hash_size)] = i2
    add_triangle(triangles=mut(triangles), halfedges=mut(halfedges), i0=i0, i1=i1, i2=i2, a=-1, b=-1, c=-1)


# Runs full Delaunator radial sweep on (xs, ys) into dynamic Vecs triangles and halfedges
def triangulate(xs, ys, triangles, halfedges) -> void:
    n = len(xs)
    seed = build_seed_triangle(xs, ys)
    ids = [0] * n
    dists = [0.0] * n
    prepare_sorted_ids(xs=xs, ys=ys, cx=seed.cx, cy=seed.cy, ids=mut(ids), dists=mut(dists))
    hash_size = int(ceil(sqrt(float(n))))
    hull_prev = [0] * n
    hull_next = [0] * n
    hull_tri = [0] * n
    hull_hash = [-1] * hash_size
    init_hull(
        xs=xs, ys=ys, seed=seed,
        triangles=mut(triangles), halfedges=mut(halfedges),
        hull_prev=mut(hull_prev), hull_next=mut(hull_next),
        hull_tri=mut(hull_tri), hull_hash=mut(hull_hash), hash_size=hash_size,
    )
    xp = 0.0
    yp = 0.0
    for k in range(n):
        i = ids[k]
        x = xs[i]
        y = ys[i]
        if k > 0 and abs(x - xp) <= EPS and abs(y - yp) <= EPS:
            continue
        xp = x
        yp = y
        if i == seed.i0 or i == seed.i1 or i == seed.i2:
            continue
        insert_point(
            xs=xs, ys=ys, triangles=mut(triangles), halfedges=mut(halfedges),
            hull_prev=mut(hull_prev), hull_next=mut(hull_next),
            hull_tri=mut(hull_tri), hull_hash=mut(hull_hash),
            hash_size=hash_size, cx=seed.cx, cy=seed.cy, i=i,
        )


# Loads 2D points via .paw, builds Delaunay mesh in native code, saves triangles & halfedges
def main() -> int:
    xs = io_bridge.load_xs()
    ys = io_bridge.load_ys()
    if len(xs) < 3:
        return 2
    triangles = [0] * 0
    halfedges = [0] * 0
    t0 = io_bridge.now_sec()
    triangulate(xs=xs, ys=ys, triangles=mut(triangles), halfedges=mut(halfedges))
    t1 = io_bridge.now_sec()
    io_bridge.save_mesh(triangles, halfedges)
    print(t1 - t0, len(triangles) // 3)
    return 0
