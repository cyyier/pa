# Crossing zone: file I/O and wall-clock timing for the Delaunator benchmark.
import os
import time
import numpy as np


def _data_dir() -> str:
    return os.environ.get("PA_DELAUNATOR_DATA_DIR", os.path.dirname(os.path.abspath(__file__)))


def load_xs() -> Vec[float]:
    return np.load(os.path.join(_data_dir(), "in_xs.npy")).astype(np.float64, copy=False)


def load_ys() -> Vec[float]:
    return np.load(os.path.join(_data_dir(), "in_ys.npy")).astype(np.float64, copy=False)


def now_sec() -> float:
    return float(time.perf_counter())


def save_mesh(triangles: span[int], halfedges: span[int]) -> void:
    d = _data_dir()
    np.save(os.path.join(d, "pa_triangles.npy"), np.frombuffer(triangles, dtype=np.int64))
    np.save(os.path.join(d, "pa_halfedges.npy"), np.frombuffer(halfedges, dtype=np.int64))
