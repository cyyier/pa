# Crossing zone: CSR-packed byte-buffer I/O and wall-clock timing for Levenshtein benchmark.
import os
import time
import numpy as np


def _data_dir() -> str:
    return os.environ.get("PA_LEV_DATA_DIR", os.path.dirname(os.path.abspath(__file__)))


def load_buf_a() -> Vec[u8]:
    return np.load(os.path.join(_data_dir(), "buf_a.npy")).astype(np.uint8, copy=False)


def load_off_a() -> Vec[int]:
    return np.load(os.path.join(_data_dir(), "off_a.npy")).astype(np.int64, copy=False)


def load_buf_b() -> Vec[u8]:
    return np.load(os.path.join(_data_dir(), "buf_b.npy")).astype(np.uint8, copy=False)


def load_off_b() -> Vec[int]:
    return np.load(os.path.join(_data_dir(), "off_b.npy")).astype(np.int64, copy=False)


def now_sec() -> float:
    return float(time.perf_counter())


def save_results(lev: span[int], osa: span[int]) -> void:
    d = _data_dir()
    np.save(os.path.join(d, "pa_lev.npy"), np.frombuffer(lev, dtype=np.int64))
    np.save(os.path.join(d, "pa_osa.npy"), np.frombuffer(osa, dtype=np.int64))
