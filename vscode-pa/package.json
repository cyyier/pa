{
  "name": "pa-lang",
  "displayName": "Pa Language",
  "description": "Pa (.pa / .paw): syntax, inferred-type inlay hints, memory-audit hover and diagnostics via `pac lsp`",
  "version": "0.1.1",
  "publisher": "cyyier",
  "license": "MIT",
  "icon": "icons/pa.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/cyyier/pa.git",
    "directory": "vscode-pa"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:pa",
    "onLanguage:paw"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pa",
        "aliases": [
          "Pa",
          "pa"
        ],
        "extensions": [
          ".pa"
        ],
        "icon": {
          "light": "./icons/pa-file.png",
          "dark": "./icons/pa-file.png"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "paw",
        "aliases": [
          "Pa Worker",
          "paw"
        ],
        "extensions": [
          ".paw"
        ],
        "icon": {
          "light": "./icons/paw.png",
          "dark": "./icons/paw.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pa",
        "scopeName": "source.pa",
        "path": "./syntaxes/pa.tmLanguage.json"
      },
      {
        "language": "paw",
        "scopeName": "source.paw",
        "path": "./syntaxes/paw.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "pa.restartServer",
        "title": "Pa: Restart Language Server"
      },
      {
        "command": "pa.buildDev",
        "title": "Pa: Build Current File (dev)"
      },
      {
        "command": "pa.buildProd",
        "title": "Pa: Build Current File (prod)"
      },
      {
        "command": "pa.check",
        "title": "Pa: Check Current File (--ai-diagnostic)"
      }
    ],
    "configuration": {
      "title": "Pa",
      "properties": {
        "pa.inlayHints.detail": {
          "type": "string",
          "enum": [
            "off",
            "simple",
            "detailed"
          ],
          "default": "off",
          "enumDescriptions": [
            "Disabled (hover-only): keep the editor clean and inspect inferred types & memory layout on hover.",
            "Python-style names only: `: int`, `: float`, `: list[float]`, `: str`; narrow types stay loud (`: int32`, `: uint8`). Memory details live in the hover card.",
            "Also show sizes and memory strategy: `: list[float, 16] (128B flat)`, `(Zero-Heap)`, `[free: RAII]`, `[memcpy ..]`."
          ],
          "description": "Whether and how much inline type hints show (hover memory-audit cards are always enabled)."
        },
        "pa.pacPath": {
          "type": "string",
          "default": "pac",
          "description": "Path to the `pac` executable. When left as `pac`, <workspace>/.venv/bin/pac is preferred if it exists."
        }
      }
    },
    "configurationDefaults": {
      "[pa]": {
        "editor.inlayHints.enabled": "off",
        "editor.semanticHighlighting.enabled": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      },
      "[paw]": {
        "editor.inlayHints.enabled": "off",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "source.pa entity.name.function.python",
              "source.pa meta.function-call.generic.python",
              "source.pa support.function.builtin.python",
              "source.paw entity.name.function.python",
              "source.paw meta.function-call.generic.python",
              "source.paw support.function.builtin.python"
            ],
            "settings": {
              "foreground": "#DCDCAA"
            }
          },
          {
            "scope": "support.function.intrinsic.pa",
            "settings": {
              "foreground": "#FF8C42",
              "fontStyle": "bold"
            }
          },
          {
            "scope": [
              "meta.decorator.pa entity.name.function.decorator.pa",
              "punctuation.decorator.pa"
            ],
            "settings": {
              "foreground": "#4EC9B0",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "support.type.primitive.pa",
            "settings": {
              "foreground": "#4FC1FF"
            }
          },
          {
            "scope": "support.type.generic.pa",
            "settings": {
              "foreground": "#4FC1FF",
              "fontStyle": "italic"
            }
          }
        ]
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0",
    "@vscode/vsce": "^3.0.0"
  },
  "author": {
    "name": "cyyier"
  },
  "homepage": "https://palang.dev",
  "bugs": {
    "url": "https://github.com/cyyier/pa/issues"
  },
  "keywords": [
    "pa",
    "paw",
    "pac",
    "llvm",
    "python",
    "language-server"
  ]
}
